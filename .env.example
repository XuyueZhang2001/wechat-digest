# 复制为 .env，程序启动时会自动读取（.env 已在 .gitignore 里）。
# 已存在的环境变量优先，不会被这里的值覆盖。

# 模型 Key：https://platform.deepseek.com 注册后，在左侧「API Keys」创建。
# 任意 OpenAI 兼容服务都可以，改下面两行 base/model 即可。
WDIGEST_API_KEY=sk-xxxxxxxx
WDIGEST_BASE_URL=https://api.deepseek.com/v1
WDIGEST_MODEL=deepseek-chat

# 付费公众号接口（kind = "dataxapi" 的信源需要）。
# https://dataxapi.com 注册后在控制台创建，格式 dx_ 开头。
# 列表 $0.02/次，正文 $0.02/篇；不用付费源就留空。
DATAXAPI_API_KEY=dx_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
